  <str prefix="promo_theatrebuddhaandlardlads_" suffix="dlg_start_4_homer" key="promo_theatrebuddhaandlardlads_dlg_start_4_homer" />
  <str prefix="promo_thespiritofgiving_" suffix="dlg_accept_1_homer" key="promo_thespiritofgiving_dlg_accept_1_homer">Mmm… ciambelle extra.</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_accept_2_lisa" key="promo_thespiritofgiving_dlg_accept_2_lisa">Ne prepariamo qualcuna per Babbo Natale?</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_accept_3_homer" key="promo_thespiritofgiving_dlg_accept_3_homer">Assolutamente no! L'unico panzone a mettere le mani sulle ciambelle sarò io.</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_art_1_gil" key="promo_thespiritofgiving_dlg_art_1_gil">Assapora le feste con ancora più ciambelle!</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_art_2_misc" key="promo_thespiritofgiving_dlg_art_2_misc">25% di ciambelle in più in ogni confezione!</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_decline_1_gil" key="promo_thespiritofgiving_dlg_decline_1_gil">Oh, cavolo! Pare che i bambini dovranno passare un altro Natale senza regali… né elettricità.</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_decline_2_gil" key="promo_thespiritofgiving_dlg_decline_2_gil">Se non riesco a vendere ciambelle a Springfield, sono rovinato!</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_start_1_gil" key="promo_thespiritofgiving_dlg_start_1_gil">Oh oh oh! Miracolo natalizio in arrivo per te!</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_start_2_gil" key="promo_thespiritofgiving_dlg_start_2_gil">In occasione delle feste, tutte le confezioni di ciambelle ne conterranno il 25% in più!</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_start_3_gil" key="promo_thespiritofgiving_dlg_start_3_gil">Il che significa una dozzina ora ne contiene 15. 50 è il nuovo 40! E quella pila di 132 ciambelle ora è… beh, il vecchio Gil non è un granché in matematica. Se lo fosse, non dovrebbe star qui in piedi al freddo a vendere ciambelle.</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_start_4_gil" key="promo_thespiritofgiving_dlg_start_4_gil">Inoltre non è granché in grammatica, visto che parla sempre di sé in terza persona…</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_start_4_homer" key="promo_thespiritofgiving_dlg_start_4_homer">Ma sai quanti lavori mi ha fatto fare quest'anno il dito venuto dal cielo!?</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_start_5_homer" key="promo_thespiritofgiving_dlg_start_5_homer">Va bene, va bene, darò un'occhiata al negozio. Basta che tu faccia silenzio!</str>
  <str prefix="promo_thespiritofgiving_" suffix="dlg_start_6_homer" key="promo_thespiritofgiving_dlg_start_6_homer">Dio ti benedica, signor grassone.</str>
  <str prefix="promo_xmas2013_" suffix="gilbubble" key="promo_xmas2013_gilbubble">Ciambelle delle feste… pigliale finché è ancora il periodo giusto!</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="1_name" key="promo_xmas2013holidaydonuts_1_name">Bonus ciambelle delle feste 2013</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="3_dlg_start_1_gil" key="promo_xmas2013holidaydonuts_3_dlg_start_1_gil">Ciambelle delle feste! Ciambelle delle feste! Disponibili solo dal vecchio Gil!</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="3_dlg_start_2_homer" key="promo_xmas2013holidaydonuts_3_dlg_start_2_homer">Gil?! Sei tu il tizio che ha accumulato tutte quelle ciambelle delle feste?</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="3_dlg_start_3_gil" key="promo_xmas2013holidaydonuts_3_dlg_start_3_gil">Esatto! E ne ho così tante che ci farò una fortuna vendendole per mesi… a prezzi gonfiati, naturalmente!</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="3_dlg_start_4_homer" key="promo_xmas2013holidaydonuts_3_dlg_start_4_homer">Mesi? Ma nessuno vorrà delle ciambelle delle feste dopo Natale.</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="3_dlg_start_5_gil" key="promo_xmas2013holidaydonuts_3_dlg_start_5_gil">Oh, no, non ci avevo pensato! Gil ci è proprio dentro fino al collo questa volta. Credi che le ciambelle avanzate dureranno fino all'anno prossimo?</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="3_dlg_start_6_homer" key="promo_xmas2013holidaydonuts_3_dlg_start_6_homer">Gil, nessuno compra ciambelle vecchie di un anno. E poi tra un anno nessuno starà più giocando a questo gioco.</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="3_dlg_start_7_gil" key="promo_xmas2013holidaydonuts_3_dlg_start_7_gil">Oddìo, hai ragione. Devo vendere l'intero quantitativo prima che il mercato crolli. Devo tagliare i prezzi, vendere in perdita… Che ne dici di ciambelle bonus con ogni acquisto?</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="3_dlg_start_8_homer" key="promo_xmas2013holidaydonuts_3_dlg_start_8_homer">*risatina* È proprio come la storia dei fratelli Hunt.</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="dlg_accept_1_gil" key="promo_xmas2013holidaydonuts_dlg_accept_1_gil">Ogni vendita che faccio è in perdita! Anche quando compri la mia merce, stai facendo del male al vecchio Gil.</str>
  <str prefix="promo_xmas2013holidaydonuts_" suffix="dlg_decline_1_gil" key="promo_xmas2013holidaydonuts_dlg_decline_1_gil">Oh, diamine, ho proprio bisogno di vendere. È importante per il livello di bancarotta che dichiarerò dopo le feste.</str>
</root>