<SpecialEvents>
	<MasterList>
		<DataID id="285000" name="FocusOnBoxOfDonuts" />
	</MasterList>
	<SpecialEvent id="285000" name="FocusOnBoxOfDonuts">
    <OnEvent event="LandVisited" user="local" ignoreTypeCheck="true">
      <Requirements>
        <Requirement type="building" building="BoxOfDonuts" />
        <Requirement type="item" item="BoxOfDonuts" checkInventoryOnly="true" not="true" />
      </Requirements>
      <Script name="PanToBoxOfDonuts" package="NewHorizons_Scripts" />
    </OnEvent>
    <OnEvent event="LandVisited" user="remote" ignoreTypeCheck="true">
      <Requirements>
        <Requirement type="place building" building="BoxOfDonuts" />
      </Requirements>
      <Script name="PanToBoxOfDonuts" package="NewHorizons_Scripts" />
    </OnEvent>
	</SpecialEvent>
</SpecialEvents>

