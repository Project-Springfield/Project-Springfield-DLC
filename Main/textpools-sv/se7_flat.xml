  <str prefix="promo_secondtap_" suffix="dlg_6_gil" key="promo_secondtap_dlg_6_gil">Okej Gil. Den här gången kanske du lyckas.</str>
  <str prefix="promo_secondtap_" suffix="dlg_7_gil" key="promo_secondtap_dlg_7_gil" />
  <str prefix="promo_secondtap_" suffix="dlg_8_gil" key="promo_secondtap_dlg_8_gil">Du har ingen aning om hur mycket jag behöver det här.</str>
  <str prefix="promo_secondtap_" suffix="dlg_9_gil" key="promo_secondtap_dlg_9_gil">Snälla köp något, jag kan inte sälja mer blod. Ooh.</str>
  <str prefix="promo_secondtap_" suffix="dlg_10_gil" key="promo_secondtap_dlg_10_gil" />
  <str prefix="promo_secondtap_" suffix="dlg_11_gil" key="promo_secondtap_dlg_11_gil" />
