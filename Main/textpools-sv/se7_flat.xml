  <str prefix="promo_santasvillageplusxmastree_" suffix="dlg_decline_3_gil_cut" key="promo_santasvillageplusxmastree_dlg_decline_3_gil_cut" />
  <str prefix="promo_santasvillageplusxmastree_" suffix="dlg_start_1_gil" key="promo_santasvillageplusxmastree_dlg_start_1_gil">Ho-ho-ho, vänta bara tills du ser vad jag har skaffat till dig idag.</str>
  <str prefix="promo_santasvillageplusxmastree_" suffix="dlg_start_2_lisa" key="promo_santasvillageplusxmastree_dlg_start_2_lisa">Är det en ponny?</str>
