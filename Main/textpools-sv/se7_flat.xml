  <str prefix="promo_buildmenutag_" suffix="nogil" key="promo_buildmenutag_nogil">Specialerbjudande!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_accept_1_gil" key="promo_dayolddonuts_dlg_accept_1_gil">Verkligen! Jisses! Ikväll får ungarna mat!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_art_1_gil" key="promo_dayolddonuts_dlg_art_1_gil">Dagsgamla munkar! De smakar inte gott men man kan köpa premiumföremål för dem.</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_art_2_misc" key="promo_dayolddonuts_dlg_art_2_misc">Munkar, upp till 25 % rabatt!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_art_3_misc" key="promo_dayolddonuts_dlg_art_3_misc">25 % fler munkar</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_decline_1_gil" key="promo_dayolddonuts_dlg_decline_1_gil">Kom igen, Gil behöver det här. De tar snart min njure!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_1_gil" key="promo_dayolddonuts_dlg_start_1_gil">Gamle Gil har ett riktigt pangerbjudande till er idag, Springfield.</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_2_gil" key="promo_dayolddonuts_dlg_start_2_gil">Dagsgamla munkar!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_3_homer" key="promo_dayolddonuts_dlg_start_3_homer">Mmm … munkar.</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_4_lisa" key="promo_dayolddonuts_dlg_start_4_lisa">Du tänker väl inte äta upp de där gamla munkarna va?</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_5_homer" key="promo_dayolddonuts_dlg_start_5_homer">Nej jag tänker köpa professor Frink med dem så att han kan bygga en tidsmaskin. Då kan jag äta munkarna när de var färska.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_accept_1_homer" key="promo_duffbreweryplusspringfieldsign_dlg_accept_1_homer">Förlåt att jag sa allt det där elaka om dig, Gil.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_accept_2_gil" key="promo_duffbreweryplusspringfieldsign_dlg_accept_2_gil">Äsch, det är okej. Bjud mig på en Duff när jag kommer tillbaka.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_accept_3_homer" key="promo_duffbreweryplusspringfieldsign_dlg_accept_3_homer">Kom inte tillbaka.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_art_1_gil" key="promo_duffbreweryplusspringfieldsign_dlg_art_1_gil">Skaffa Duff-bryggeriet med maskoten Duffman!</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_art_2_misc" key="promo_duffbreweryplusspringfieldsign_dlg_art_2_misc">Innehåller 50 000 $, Springfieldskylt, Duffman och Duff-bryggeriet!</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_decline_1_gil" key="promo_duffbreweryplusspringfieldsign_dlg_decline_1_gil">Om du ångrar dig finns erbjudandet på menyn med premiumföremål.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_decline_2_gil" key="promo_duffbreweryplusspringfieldsign_dlg_decline_2_gil">Fast då får jag ingen provision.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_1_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_1_gil">Okej, Gil. Som du övade.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_2_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_2_gil">Ursäkta mig min goda herre!</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_3_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_3_homer">Inte du igen! Du är det mest irriterande i hela stan.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_4_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_4_homer">Du vet att alla hatar dig, va?</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_5_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_5_gil">Gör de? Varför?</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_6_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_6_homer">För att du är reklam. Vi är folk som gör roliga grejer och tjänar pengar. Du är bara reklam.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_7_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_7_gil">Jisses, jag försöker ju bara få ihop pengar till ungarnas tandställningar.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_8_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_8_homer">Okej. Men jag är inte intresserad av vad du än har att sälja.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_9_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_9_gil">Duff Brewery, tillsammans med Duffman.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_10_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_10_homer">Verkligen?</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_11_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_11_homer">Gil, du är bäst! Jag älskar dig!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_accept_1_frink" key="promo_frinklabplusbuddha_dlg_accept_1_frink">Vetenskapen!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_accept_2_kearney" key="promo_frinklabplusbuddha_dlg_accept_2_kearney">Tyst, nörd! *smäll*</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_1_gil" key="promo_frinklabplusbuddha_dlg_art_1_gil">Vem vill inte ha en jobbig nörd i sin stad?</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_2_misc" key="promo_frinklabplusbuddha_dlg_art_2_misc">Och få all de här andra grejerna!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_3_misc" key="promo_frinklabplusbuddha_dlg_art_3_misc">Frinks labb, professor Frink, 50 000 pengar och Buddha-Homer.</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_4_misc" key="promo_frinklabplusbuddha_dlg_art_4_misc">Värt 490 munkar!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_decline_1_frink" key="promo_frinklabplusbuddha_dlg_decline_1_frink">Det är den här typen av ointresse i vetenskap som gör att vi aldrig kommer till Mars!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_start_1_gil" key="promo_frinklabplusbuddha_dlg_start_1_gil">Vetenskapsmän! Köp era vetenskapsmän här!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_start_2_lisa" key="promo_frinklabplusbuddha_dlg_start_2_lisa">Du kan inte sälja skapandet av vetenskapsmän! Det kan bara skolor göra.</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_start_3_frink" key="promo_frinklabplusbuddha_dlg_start_3_frink">Snälla lilla flicka! Jag har varit instängd i ett existentiellt plan som bara jag förstår så länge nu. Jag vill bara komma tillbaka och stänga in mig i mitt laboratorium.</str>
  <str prefix="promo_icecreamman_" suffix="title" key="promo_icecreamman_title">Glassbil</str>
  <str prefix="promo_lairsign_" suffix="dlg_accept_1_hankscorpio" key="promo_lairsign_dlg_accept_1_hankscorpio">Bra jobbat, Gil. Nu ska vi bara förslava människorna och få dem att arbeta i min gruva.</str>
  <str prefix="promo_lairsign_" suffix="dlg_accept_2_gil" key="promo_lairsign_dlg_accept_2_gil">Jisses, ett jobb!</str>
  <str prefix="promo_lairsign_" suffix="dlg_art_1_gil" key="promo_lairsign_dlg_art_1_gil">Det finns inget som en enorm lasermackapär om man vill imponera!</str>
  <str prefix="promo_lairsign_" suffix="dlg_art_2_misc" key="promo_lairsign_dlg_art_2_misc">Vulkantillhåll, onda supergeniet Hank Scorpio och en Springfieldskylt</str>
  <str prefix="promo_lairsign_" suffix="dlg_art_3_misc" key="promo_lairsign_dlg_art_3_misc">Värt 370 munkar!</str>
  <str prefix="promo_lairsign_" suffix="dlg_decline_1_gil" key="promo_lairsign_dlg_decline_1_gil">Kom igen! Vill ni inte skydda staden från fjollträskarna?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_1_gil" key="promo_lairsign_dlg_start_1_gil">Hallå Springfield! Är ni trötta på att låta överheten styra er?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_2_homer" key="promo_lairsign_dlg_start_2_homer">Vem är överhet?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_3_gil" key="promo_lairsign_dlg_start_3_gil">Politikerna!</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_4_homer" key="promo_lairsign_dlg_start_4_homer">Polivaddå?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_5_gil" key="promo_lairsign_dlg_start_5_gil">Nu kan ni i alla fall skriva stadens namn på ett berg och låta en dödsstråle beskydda er!</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_6_homer" key="promo_lairsign_dlg_start_6_homer">För det finns väl inget träsk där?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_7_gil" key="promo_lairsign_dlg_start_7_gil">Nä, konstigt.</str>
