  <str prefix="promo_secondtap_" suffix="dlg_1_gil" key="promo_secondtap_dlg_1_gil">Halleluja, du är tillbaka! Kom igen Gil, sköt det här snyggt nu.</str>
  <str prefix="promo_secondtap_" suffix="dlg_2_gil" key="promo_secondtap_dlg_2_gil" />
  <str prefix="promo_secondtap_" suffix="dlg_3_gil" key="promo_secondtap_dlg_3_gil">Snäll, köp något den här gången.</str>
  <str prefix="promo_secondtap_" suffix="dlg_4_gil" key="promo_secondtap_dlg_4_gil">En till chans? Tack, tack, tack!</str>
