  <str prefix="promo_blackfriday_" suffix="3_dlg_accept_1_gil" key="promo_blackfriday_3_dlg_accept_1_gil">Pølse! Du kommer ikke til angre! Jeg lover!</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_accept_2_gil" key="promo_blackfriday_3_dlg_accept_2_gil">… Det er ikke en lovbindende garanti, forresten.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_decline_1_gil" key="promo_blackfriday_3_dlg_decline_1_gil">Vel, om du endrer mening kan du finne tilbudet på premiumgjenstandsmenyen.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_decline_2_gil" key="promo_blackfriday_3_dlg_decline_2_gil">Selv om jeg ikke får noe provisjon når du kjøper det på den måten.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_1_gil" key="promo_blackfriday_3_dlg_start_1_gil">Hei, gamle Gil har litt av et «Black Friday»-salg for deg!</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_2_gil" key="promo_blackfriday_3_dlg_start_2_gil">Du trenger det sikkert ikke, vil sikkert ikke ha det heller -- det er kanskje til og med kanskje ikke en bra deal i det hele tatt.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_3_gil" key="promo_blackfriday_3_dlg_start_3_gil">Men det er Black Friday, så du tror sikkert det er det. Så da kjøpe du det!</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_4_gil" key="promo_blackfriday_3_dlg_start_4_gil">Vær så snill. Kjøp den!</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_5_gil" key="promo_blackfriday_3_dlg_start_5_gil" />
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_6_gil" key="promo_blackfriday_3_dlg_start_6_gil" />
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_7_gil" key="promo_blackfriday_3_dlg_start_7_gil" />
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_8_gil" key="promo_blackfriday_3_dlg_start_8_gil" />
  <str prefix="promo_blackfriday_" suffix="dlg_art_1_gil" key="promo_blackfriday_dlg_art_1_gil">Her har du noen greier som ikke har noe som helst med thanksgiving å gjøre, men du vil sikkert kjøpe det uansett!</str>
  <str prefix="promo_blackfriday_" suffix="dlg_art_2_misc" key="promo_blackfriday_dlg_art_2_misc">Inkluderer Duffman, Duff Bryggeri, Springfield-skilt og 50 000 $!</str>
  <str prefix="promo_blackfriday_" suffix="infotext" key="promo_blackfriday_infotext">En gjenstand på tilbud hver time! Sjekk innom ofte!</str>
  <str prefix="promo_blackfriday_" suffix="speechbubble" key="promo_blackfriday_speechbubble">Kjøp ting som er på salg i en begrenset periode og få donut-rabatter på stedet!</str>
