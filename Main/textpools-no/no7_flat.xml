  <str prefix="promo_buildmenutag_" suffix="nogil" key="promo_buildmenutag_nogil">Spesialtilbud!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_accept_1_gil" key="promo_dayolddonuts_dlg_accept_1_gil">Virkelig? Du store! De barne kommer til å spise i kveld!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_art_1_gil" key="promo_dayolddonuts_dlg_art_1_gil">Gårsdagens donuts! De smaker ikke like godt, men de kan fortsatt brukes til å kjøpe premiuminnhold.</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_art_2_misc" key="promo_dayolddonuts_dlg_art_2_misc">Donuts med opptil 25 % rabatt!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_art_3_misc" key="promo_dayolddonuts_dlg_art_3_misc">25 % flere donuts!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_decline_1_gil" key="promo_dayolddonuts_dlg_decline_1_gil">Kom igjen, Gil trenger dette. De kommer til å ta nyra mi!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_1_gil" key="promo_dayolddonuts_dlg_start_1_gil">Gamle Gil har en herlig godbit til dere i dag, Springfield.</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_2_gil" key="promo_dayolddonuts_dlg_start_2_gil">Gårsdagens donuts!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_3_homer" key="promo_dayolddonuts_dlg_start_3_homer">Mmm… donuts.</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_4_lisa" key="promo_dayolddonuts_dlg_start_4_lisa">Du har ikke tenkt til å spise gamle donuts, har du?</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_5_homer" key="promo_dayolddonuts_dlg_start_5_homer">Nei, jeg skal bruke dem til å kjøpe professor Frink, få ham til å bygge en tidsmaskin, reise tilbake i tid til da de fortsatt var ferske. Og DA skal jeg spise dem.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_accept_1_homer" key="promo_duffbreweryplusspringfieldsign_dlg_accept_1_homer">Jeg beklager at jeg sa alle de slemme tingene til deg, Gil.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_accept_2_gil" key="promo_duffbreweryplusspringfieldsign_dlg_accept_2_gil">Ååh, det går greit. Kanskje du kan kjøpe meg en Duff neste gang jeg kommer tilbake.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_accept_3_homer" key="promo_duffbreweryplusspringfieldsign_dlg_accept_3_homer">Ikke kom tilbake.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_art_1_gil" key="promo_duffbreweryplusspringfieldsign_dlg_art_1_gil">Få Duff bryggeri, komplett med det maniske bedriftsikonet, Duffman!</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_art_2_misc" key="promo_duffbreweryplusspringfieldsign_dlg_art_2_misc">Inkludert 50 000 $, Springfield-skilt, Duffman og Duff bryggeri!</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_decline_1_gil" key="promo_duffbreweryplusspringfieldsign_dlg_decline_1_gil">Vel, om du endrer mening kan du finne tilbudet på premiumgjenstandsmenyen.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_decline_2_gil" key="promo_duffbreweryplusspringfieldsign_dlg_decline_2_gil">Selv om jeg ikke får noe provisjon når du kjøper det på den måten.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_1_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_1_gil">OK, Gil. Akkurat som du øvde det inn.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_2_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_2_gil">Unnskyld meg, mine gode man --</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_3_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_3_homer">Nei, ikke deg igjen! Du er den mest irriterende greia i hele byen!</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_4_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_4_homer">Du vet at alle hater deg, ikke sant?</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_5_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_5_gil">Gjør dem? Hvorfor?</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_6_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_6_homer">Fordi du er en reklame. VI er folk, som gjør morsomme ting og tjener penger Men du er bare en reklame.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_7_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_7_gil">Ååh, jøss. Jeg prøver bare å betale for podens regulering … for beina, ikke tenna.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_8_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_8_homer">Ugh, greit. Men hva enn du selger, så er jeg ikke interessert.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_9_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_9_gil">Duff bryggeri, komplett med Duffman.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_10_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_10_homer">Virkelig?</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_11_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_11_homer">Gil, du er best! Jeg elsker deg, jeg elsker deg, jeg elsker deg …</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_accept_1_frink" key="promo_frinklabplusbuddha_dlg_accept_1_frink">Gi en applaus til forskning!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_accept_2_kearney" key="promo_frinklabplusbuddha_dlg_accept_2_kearney">Klapp igjen, nerd! *slår*</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_1_gil" key="promo_frinklabplusbuddha_dlg_art_1_gil">Hvem vil vel ikke ha en pinlig nerd i byen sin?</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_2_misc" key="promo_frinklabplusbuddha_dlg_art_2_misc">Og få alle disse andre greiene!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_3_misc" key="promo_frinklabplusbuddha_dlg_art_3_misc">Inkludert: Frinks laboratorium, professor Frinkk, 50 000 $ og Buddha-Homer.</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_4_misc" key="promo_frinklabplusbuddha_dlg_art_4_misc">490 donut-verdi!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_decline_1_frink" key="promo_frinklabplusbuddha_dlg_decline_1_frink">Det er en denslags fravær på forskningsinteresse som forhindrer oss fra å dra til Mars!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_start_1_gil" key="promo_frinklabplusbuddha_dlg_start_1_gil">Forskere! Kjøp forskere her!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_start_2_lisa" key="promo_frinklabplusbuddha_dlg_start_2_lisa">Du kan ikke selge oppskriften på forskere! Bare gradsstudier kan gjøre det.</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_start_3_frink" key="promo_frinklabplusbuddha_dlg_start_3_frink">Vær så snill, vennen, jeg har vært fanget helt alene i så lang tid på et eksistensplan som bare jeg forstår. Jeg vil bare komme tilbake og bli fanget i mitt eget laboratorium.</str>
  <str prefix="promo_icecreamman_" suffix="title" key="promo_icecreamman_title">Iskrembil</str>
  <str prefix="promo_lairsign_" suffix="dlg_accept_1_hankscorpio" key="promo_lairsign_dlg_accept_1_hankscorpio">Det er godt jobbet, Gil. Nå er det bare å ta kontroll over menneskeheten og få dem alle til å jobben i gruvene mine.</str>
  <str prefix="promo_lairsign_" suffix="dlg_accept_2_gil" key="promo_lairsign_dlg_accept_2_gil">Du store, en jobb!</str>
  <str prefix="promo_lairsign_" suffix="dlg_art_1_gil" key="promo_lairsign_dlg_art_1_gil">Ikke noe sier «Jeg bestemmer» som en stor superlaser!</str>
  <str prefix="promo_lairsign_" suffix="dlg_art_2_misc" key="promo_lairsign_dlg_art_2_misc">Inkludert: Vulkanhule, det onde supergeniet Hank Scorpio og Springfield-skiltet.</str>
  <str prefix="promo_lairsign_" suffix="dlg_art_3_misc" key="promo_lairsign_dlg_art_3_misc">370 donut-verdi!</str>
  <str prefix="promo_lairsign_" suffix="dlg_decline_1_gil" key="promo_lairsign_dlg_decline_1_gil">Kom igjen! Vil du ikke beskytte byen din mot de colombianerne?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_1_gil" key="promo_lairsign_dlg_start_1_gil">Heisann, Springfield! Er dere lei av at "han" sier hva dere skal gjøre?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_2_homer" key="promo_lairsign_dlg_start_2_homer">Hvem?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_3_gil" key="promo_lairsign_dlg_start_3_gil">Han i Washington!</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_4_homer" key="promo_lairsign_dlg_start_4_homer">Hvilket Washington?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_5_gil" key="promo_lairsign_dlg_start_5_gil">Vel, nå kan du kjempe din sak mot regjeringen ved å skrive din bys navn over hele fjellet og beskytte den med en dødsstråle!</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_6_homer" key="promo_lairsign_dlg_start_6_homer">For du har staten Washington og du har District of Columbia … som er ganske rart. Er ikke Columbia et annet land?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_7_gil" key="promo_lairsign_dlg_start_7_gil">Ja, det er ganske rart.</str>
