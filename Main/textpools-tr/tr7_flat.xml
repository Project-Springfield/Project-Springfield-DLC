  <str prefix="promo_blackfriday_" suffix="3_dlg_accept_1_gil" key="promo_blackfriday_3_dlg_accept_1_gil">Sosisli! Pişman olmayacaksın! Garanti ediyorum!</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_accept_2_gil" key="promo_blackfriday_3_dlg_accept_2_gil">…Bu arada bunun yasal bağlayıcılığı olmadığını bil.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_decline_1_gil" key="promo_blackfriday_3_dlg_decline_1_gil">Pekala, fikrini değiştirecek olursan teklifi premium eşya menüsünde bulabilirsin.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_decline_2_gil" key="promo_blackfriday_3_dlg_decline_2_gil">Oradan alacak olsan bile ben komisyon almıyorum.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_1_gil" key="promo_blackfriday_3_dlg_start_1_gil">Hey, İhtiyar Gil'in sana özel bir Kara Cuma indirimi var!</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_2_gil" key="promo_blackfriday_3_dlg_start_2_gil">Muhtemelen buna ihtiyacın yok ve hata bunu istemiyorsun; lanet olsun belki de iyi bir kampanya bile değil.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_3_gil" key="promo_blackfriday_3_dlg_start_3_gil">Fakat Kara Cuma olduğundan, kampanyanın iyi olduğunu düşünüyorsun. Ve satın alacaksın!</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_4_gil" key="promo_blackfriday_3_dlg_start_4_gil">Lütfen satın al.</str>
