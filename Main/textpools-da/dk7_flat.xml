  <str prefix="promo_buildmenutag_" suffix="nogil" key="promo_buildmenutag_nogil">Særtilbud!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_accept_1_gil" key="promo_dayolddonuts_dlg_accept_1_gil">Seriøst? Jamen, der kan man bare se! Så får børnene alligevel mad i aften!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_art_1_gil" key="promo_dayolddonuts_dlg_art_1_gil">Daggamle donuts! De smager ikke lige så godt, men de er lige så gode til at købe luksusindhold for.</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_art_2_misc" key="promo_dayolddonuts_dlg_art_2_misc">Op til 25 % rabat på donuts!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_art_3_misc" key="promo_dayolddonuts_dlg_art_3_misc">25 % flere donuts!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_decline_1_gil" key="promo_dayolddonuts_dlg_decline_1_gil">Kom nu, Gil har virkelig brug for det her. De har tænkt sig at tage min nyre!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_1_gil" key="promo_dayolddonuts_dlg_start_1_gil">Gode, gamle Gil har en sand lækkerbisken til dig i dag, Springfield.</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_2_gil" key="promo_dayolddonuts_dlg_start_2_gil">Daggamle donuts!</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_3_homer" key="promo_dayolddonuts_dlg_start_3_homer">Mmm… donuts.</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_4_lisa" key="promo_dayolddonuts_dlg_start_4_lisa">Du har ikke seriøst tænkt dig at spise de mugne donuts, har du?</str>
  <str prefix="promo_dayolddonuts_" suffix="dlg_start_5_homer" key="promo_dayolddonuts_dlg_start_5_homer">Nej, jeg har tænkt mig at bruge dem til at købe Professor Frink, som jeg så vil få til at bygge en tidsmaskine, så jeg kan rejse tilbage til dengang, hvor donuttene stadig var friske. Og så spise dem.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_accept_1_homer" key="promo_duffbreweryplusspringfieldsign_dlg_accept_1_homer">Jeg er ked af, at jeg sagde alle de onde ting om dig, Gil.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_accept_2_gil" key="promo_duffbreweryplusspringfieldsign_dlg_accept_2_gil">Ork, det gør ikke noget. Du kan jo byde på en Duff næste gang, jeg kommer tilbage.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_accept_3_homer" key="promo_duffbreweryplusspringfieldsign_dlg_accept_3_homer">Lad være med at komme tilbage.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_art_1_gil" key="promo_duffbreweryplusspringfieldsign_dlg_art_1_gil">Få Duff-bryggeriet samt den maniske stikirenddreng Duffman!</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_art_2_misc" key="promo_duffbreweryplusspringfieldsign_dlg_art_2_misc">Inklusive 50.000 $, Springfield-skilt, Duffman og Duff-bryggeriet!</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_decline_1_gil" key="promo_duffbreweryplusspringfieldsign_dlg_decline_1_gil">Nåh, men hvis du ændrer mening, kan du finde tilbuddet i din luksusgenstandsmenu.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_decline_2_gil" key="promo_duffbreweryplusspringfieldsign_dlg_decline_2_gil">Men jeg får altså ikke kommission, når du køber den på den måde.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_1_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_1_gil">Okay, Gil. Præcis, som du har øvet det.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_2_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_2_gil">Undskyld mig, gode herre–</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_3_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_3_homer">Åh nej, ikke dig igen! Du er den mest irriterende ting i denne by!</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_4_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_4_homer">Du ved godt, at alle hader dig, ikke?</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_5_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_5_gil">Gør de? Hvorfor?</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_6_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_6_homer">Fordi du er en omvandrende reklame. Vi er mennesker, der gør sjove ting og tjener penge. Men du er kun en reklame.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_7_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_7_gil">Øv altså. Jeg forsøger bare at betale for mine børns proteser … benproteser, ikke tandproteser.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_8_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_8_homer">Fint. Men uanset hvad du sælger, er jeg ikke interesseret.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_9_gil" key="promo_duffbreweryplusspringfieldsign_dlg_start_9_gil">Duff-bryggeriet samt Duffman.</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_10_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_10_homer">Virkelig?</str>
  <str prefix="promo_duffbreweryplusspringfieldsign_" suffix="dlg_start_11_homer" key="promo_duffbreweryplusspringfieldsign_dlg_start_11_homer">Gil, du er den bedste! Jeg elsker dig, elsker dig, elsker dig …</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_accept_1_frink" key="promo_frinklabplusbuddha_dlg_accept_1_frink">Lad os give videnskaben en hånd!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_accept_2_kearney" key="promo_frinklabplusbuddha_dlg_accept_2_kearney">Hold kæft, nørd! *slår*</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_1_gil" key="promo_frinklabplusbuddha_dlg_art_1_gil">Hvem ville ikke gerne have en akavet nørd i deres by?</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_2_misc" key="promo_frinklabplusbuddha_dlg_art_2_misc">Og få alt det her andet halløj!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_3_misc" key="promo_frinklabplusbuddha_dlg_art_3_misc">Indeholder: Frinks laboratorium, Professor Frink, 50.000 $ og Homer-buddha.</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_art_4_misc" key="promo_frinklabplusbuddha_dlg_art_4_misc">Til en værdi af 490 donuts!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_decline_1_frink" key="promo_frinklabplusbuddha_dlg_decline_1_frink">Det er den slags manglende interesse i videnskab, der holder os fra at besøge Mars!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_start_1_gil" key="promo_frinklabplusbuddha_dlg_start_1_gil">Videnskabsmænd! Køb jeres videnskabsmænd her!</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_start_2_lisa" key="promo_frinklabplusbuddha_dlg_start_2_lisa">Du kan ikke sælge skabelsen af en videnskabsmand! Det er kun overbygningsstudier, der kan det.</str>
  <str prefix="promo_frinklabplusbuddha_" suffix="dlg_start_3_frink" key="promo_frinklabplusbuddha_dlg_start_3_frink">Vær nu sød, lille pige. Jeg har alt for længe været fanget alene på et eksistensplan, som kun jeg forstår. Jeg vil bare gerne tilbage og være isoleret i mit eget laboratorium.</str>
  <str prefix="promo_icecreamman_" suffix="title" key="promo_icecreamman_title">Isbil</str>
  <str prefix="promo_lairsign_" suffix="dlg_accept_1_hankscorpio" key="promo_lairsign_dlg_accept_1_hankscorpio">Stærkt arbejde, Gil. Nu skal jeg bare slavebinde menneskeheden og sætte jer alle til at arbejde i mine miner.</str>
  <str prefix="promo_lairsign_" suffix="dlg_accept_2_gil" key="promo_lairsign_dlg_accept_2_gil">Et job, sådan!</str>
  <str prefix="promo_lairsign_" suffix="dlg_art_1_gil" key="promo_lairsign_dlg_art_1_gil">Intet siger "jeg styrer" som en gigantisk superlaser!</str>
  <str prefix="promo_lairsign_" suffix="dlg_art_2_misc" key="promo_lairsign_dlg_art_2_misc">Indeholder: Vulkanhule, det onde supergeni Hank Scorpio og Springfield-skiltet.</str>
  <str prefix="promo_lairsign_" suffix="dlg_art_3_misc" key="promo_lairsign_dlg_art_3_misc">Til en værdi af 370 donuts!</str>
  <str prefix="promo_lairsign_" suffix="dlg_decline_1_gil" key="promo_lairsign_dlg_decline_1_gil">Kom nu! Vil du ikke beskytte din by mod de colombianere?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_1_gil" key="promo_lairsign_dlg_start_1_gil">Springfield! Er du træt af, at "manden" fortæller dig, hvad du skal gøre?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_2_homer" key="promo_lairsign_dlg_start_2_homer">Hvilken mand?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_3_gil" key="promo_lairsign_dlg_start_3_gil">Manden i Washington!</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_4_homer" key="promo_lairsign_dlg_start_4_homer">Hvilken Washington?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_5_gil" key="promo_lairsign_dlg_start_5_gil">Nu kan du trodse vores regering ved at skrible navnet på din by hen over et bjerg og beskytte byen med en dødsstråle!</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_6_homer" key="promo_lairsign_dlg_start_6_homer">For der er delstaten Washington og District of Columbia … hvilket er lidt underligt. Er Colombia ikke et andet land?</str>
  <str prefix="promo_lairsign_" suffix="dlg_start_7_gil" key="promo_lairsign_dlg_start_7_gil">Ja, det er underligt.</str>
