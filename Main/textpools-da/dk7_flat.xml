  <str prefix="promo_blackfriday_" suffix="3_dlg_accept_1_gil" key="promo_blackfriday_3_dlg_accept_1_gil">Hellige ko! Det vil du ikke fortryde! Det lover jeg!</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_accept_2_gil" key="promo_blackfriday_3_dlg_accept_2_gil">… Det er forresten ikke en juridisk bindende garanti.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_decline_1_gil" key="promo_blackfriday_3_dlg_decline_1_gil">Nåh, men hvis du ændrer mening, kan du finde tilbuddet i luksusgenstandsmenuen.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_decline_2_gil" key="promo_blackfriday_3_dlg_decline_2_gil">Men jeg får altså ikke kommission, når du køber den på den måde.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_1_gil" key="promo_blackfriday_3_dlg_start_1_gil">Hey, kom og se! Gamle Gil har et fantastisk Sort fredag-tilbud til dig!</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_2_gil" key="promo_blackfriday_3_dlg_start_2_gil">Du har nok ikke brug for det og vil måske heller ikke have det – det er måske ikke engang et særligt godt tilbud.</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_3_gil" key="promo_blackfriday_3_dlg_start_3_gil">Men det er Sort fredag, så du vil tro, at det er. Og du vil købe det!</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_4_gil" key="promo_blackfriday_3_dlg_start_4_gil">Vil du ikke nok købe det?</str>
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_5_gil" key="promo_blackfriday_3_dlg_start_5_gil" />
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_6_gil" key="promo_blackfriday_3_dlg_start_6_gil" />
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_7_gil" key="promo_blackfriday_3_dlg_start_7_gil" />
  <str prefix="promo_blackfriday_" suffix="3_dlg_start_8_gil" key="promo_blackfriday_3_dlg_start_8_gil" />
  <str prefix="promo_blackfriday_" suffix="dlg_art_1_gil" key="promo_blackfriday_dlg_art_1_gil">Her er noget, der intet har at gøre med Thanksgiving, men som du helt bestemt vil købe alligevel!</str>
  <str prefix="promo_blackfriday_" suffix="dlg_art_2_misc" key="promo_blackfriday_dlg_art_2_misc">Inkluderer Duffman, Duff-bryggeri, Springfield-skilt og 50.000 $!</str>
  <str prefix="promo_blackfriday_" suffix="infotext" key="promo_blackfriday_infotext">Et nyt genstandstilbud hver time! Kig ind ofte!</str>
  <str prefix="promo_blackfriday_" suffix="speechbubble" key="promo_blackfriday_speechbubble">Køb genstande på udsalg i begrænset tid, og få donut-rabatter på stedet!</str>
